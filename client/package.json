    "dev": "powershell -NoProfile -Command \"$port = if ($env:VITE_DEV_PORT) { [int]$env:VITE_DEV_PORT } else { 5176 }; $p=(Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1).OwningProcess; if($p){Write-Host \\\"[dev] Port $port busy, killing PID $p\\\"; Stop-Process -Id $p -Force}\" && vite",
